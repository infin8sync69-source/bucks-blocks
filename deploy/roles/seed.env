# /etc/bucks/bucks.env for a SEED node: relays blocks and transactions and holds no keys.
# Public: the P2P port only (main 8733/tcp, test 18733/tcp); bootstrap-ubuntu.sh opens it in ufw.
# Its public name:port goes into ChainParams::seedNodes before the release (docs/MAINNET_INPUTS.md,
# seed nodes) or is handed to other operators for --seed.
#
# The API runs on loopback only, so bucks-healthcheck can read height, peers and fork alerts (those
# GET routes need no token). Do not create wallets on a seed.
BUCKS_NETWORK=main
BUCKS_ARGS="--server --port 8080 --api-bind 127.0.0.1 --api-token-file /etc/bucks/api-token --p2p-port 8733"
# Other seeds and long-lived peers, e.g. "--seed seed2.example.org:8733 --connect 203.0.113.7:8733".
BUCKS_PEERS=""
