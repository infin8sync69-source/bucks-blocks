# /etc/bucks/bucks.env for a MINER.
# --auto-mine implies --server; the API stays on 127.0.0.1 and its port is never opened in the firewall.
# --mine-address pays every block to an address whose key is NOT on this machine: create that wallet
# on your own computer (your own node and console), write its phrase down offline, and put its address
# here. The node refuses to start (exit 2) with this placeholder, a typo or another network's address,
# so a miner never runs with nowhere to pay.
# --mine-threads: hashing threads. Leave a core for the node, the API and P2P; bootstrap-ubuntu.sh
# writes the number of cores minus one.
BUCKS_NETWORK=main
BUCKS_ARGS="--auto-mine --mine-address REPLACE_WITH_PAYOUT_ADDRESS --mine-threads 1 --port 8080 --api-bind 127.0.0.1 --api-token-file /etc/bucks/api-token --p2p-port 8733"
# Seeds and long-lived peers, e.g. "--seed seed1.example.org:8733". A miner without peers mines a
# private chain that nobody else sees.
BUCKS_PEERS=""
