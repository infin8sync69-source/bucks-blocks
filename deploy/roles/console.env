# /etc/bucks/bucks.env for the operator WEB CONSOLE behind nginx (nginx-bucks-console.conf).
# The console is a single-operator admin UI: the one API token unlocks every wallet on this node and
# wallets.json holds their private keys. It is not a multi-user wallet site; users run their own node.
# nginx puts an IP allowlist and basic auth in front of the token login.
#   --api-bind 127.0.0.1        the API is reachable only through nginx; its port stays closed in ufw
#   --api-allowed-host <name>   the Host nginx forwards; any other Host gets 403
#   --trust-proxy               believe nginx's X-Forwarded-For (rate limit per client) and
#                               X-Forwarded-Proto (honoured only from loopback, where nginx runs)
#   --api-secure-cookie         the browser talks TLS: Secure session cookie, https origins only
#   --api-token-file            the login token, the same across restarts (sudo cat /etc/bucks/api-token)
BUCKS_NETWORK=main
BUCKS_ARGS="--server --port 8080 --api-bind 127.0.0.1 --api-allowed-host console.example.org --trust-proxy --api-secure-cookie --api-token-file /etc/bucks/api-token --p2p-port 8733"
# Seeds and long-lived peers, e.g. "--seed seed1.example.org:8733".
BUCKS_PEERS=""
