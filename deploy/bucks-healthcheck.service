# /etc/systemd/system/bucks-healthcheck.service
# Fails (and logs one line to the journal) when the node is unhealthy. Hook alerting with
# OnFailure=<your-notify-unit>@%n.service, or point an external monitor at the same script.
[Unit]
Description=Bucks health check
After=bucks.service

[Service]
Type=oneshot
User=bucks
Group=bucks
ExecStart=/usr/local/sbin/bucks-healthcheck
# 1 = WARNING is not a unit failure; 2 = CRITICAL is.
SuccessExitStatus=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
